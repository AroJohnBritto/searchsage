# Tier 1, native Google Search grounding.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Tier 2, knowledge-only fallback via an OpenAI-compatible hosted endpoint.
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Tier 3, last resort, web scrape plus an OpenAI-compatible model router.
OPENROUTER_API_KEY=your-openrouter-api-key

# Public URL of this backend once deployed, used as the outbound HTTP
# Referer for the tier 3 provider and nowhere user-facing.
APP_URL=https://searchsage.onrender.com

# Optional API-key auth. Leave AUTH_ENABLED=false for local development.
AUTH_ENABLED=false
API_KEYS=

# Path to the SQLite file used for sessions, history, feedback and cache.
DB_PATH=searchsage.db

# Local Streamlit UI should point at your local backend, not production.
SEARCHSAGE_BACKEND_URL=http://localhost:8000
